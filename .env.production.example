# STRAX - Production
# Copier vers .env sur le serveur, puis remplacer uniquement les valeurs CHANGE_ME.

APP_ENV=production
APP_DEBUG=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
APP_ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_HEX_CHARACTERS

# Base de donnees de production
DB_HOST_PROD=localhost
DB_DATABASE_PROD=CHANGE_ME
DB_USERNAME_PROD=CHANGE_ME
DB_PASSWORD_PROD=CHANGE_ME
DB_DUMP_BINARY=mysqldump

# Courriel transactionnel
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Strax
VALIDATION_NOTIFICATION_EMAILS=operations@example.com
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_TIMEOUT=15

# Facebook Pages / Meta Graph API
META_CLIENT_ID=CHANGE_ME
META_CLIENT_SECRET=CHANGE_ME
META_GRAPH_VERSION=v23.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic

# Instagram Business Login (connecteur direct en cours d'integration)
INSTAGRAM_CLIENT_ID=CHANGE_ME
INSTAGRAM_CLIENT_SECRET=CHANGE_ME
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages,instagram_business_manage_insights

# Connecteurs generiques facultatifs
PUBLICATION_API_WEBHOOK=
KPI_COLLECTION_API_WEBHOOK=
