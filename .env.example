# Exemple de configuration mail - ne jamais commiter un vrai mot de passe
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Strax
VALIDATION_NOTIFICATION_EMAILS=operations@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
